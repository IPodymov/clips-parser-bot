# ---------- Telegram ----------
# Token from @BotFather
BOT_TOKEN=123456:replace-me
# api_id / api_hash from https://my.telegram.org → API development tools.
# Needed by the Local Bot API server (telegram-bot-api container).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local Bot API server URL. In docker-compose it is overridden with
# http://telegram-bot-api:8081. Leave empty to use the official api.telegram.org
# (then files are limited to 50 MB).
BOT_API_URL=

# ---------- PostgreSQL ----------
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=bot
# Used from the host (alembic, local runs). Docker services get their own URL.
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5433/bot

# ---------- Redis ----------
# Used from the host. Docker services get redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# ---------- Downloader ----------
# Max video size to download and send, MB (Local Bot API allows up to 2000)
MAX_FILE_SIZE_MB=2000
# Temporary files directory (in docker: shared volume /downloads)
DOWNLOAD_DIR=downloads
# Hard timeout for a single download, seconds
DOWNLOAD_TIMEOUT_SEC=600
# Optional proxy for yt-dlp, e.g. socks5://user:pass@host:1080
PROXY_URL=
# Optional Netscape-format cookies file for yt-dlp (Instagram, age-restricted YouTube)
YTDLP_COOKIES_FILE=

# ---------- Bot behaviour ----------
# Anti-flood: max links per user per minute
RATE_LIMIT_PER_MINUTE=5
# How long a Telegram file_id is cached per URL, days
CACHE_TTL_DAYS=30

LOG_LEVEL=INFO
